<Window x:Class="Isle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Isle.Controls"
        Title="Isle" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        Width="640" Height="560" UseLayoutRounding="True"
        FontFamily="SF Pro Text, ./Assets/Fonts/#Inter, Segoe UI" Foreground="White" FontSize="13" Typography.NumeralAlignment="Tabular"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- SF Symbols-style transport glyphs (play.fill, pause.fill, backward.fill, forward.fill) -->
        <Geometry x:Key="GPlay">M 2,0 L 2,20 L 18,10 Z</Geometry>
        <Geometry x:Key="GPause">M 1,0 L 6,0 L 6,20 L 1,20 Z M 12,0 L 17,0 L 17,20 L 12,20 Z</Geometry>
        <Geometry x:Key="GNext">M 0,0 L 0,14 L 11,7 Z M 11,0 L 11,14 L 22,7 Z</Geometry>
        <Geometry x:Key="GPrev">M 22,0 L 22,14 L 11,7 Z M 11,0 L 11,14 L 0,7 Z</Geometry>
        <SolidColorBrush x:Key="Secondary" Color="#99EBEBF5"/>
        <SolidColorBrush x:Key="Tertiary" Color="#4DEBEBF5"/>
        <SolidColorBrush x:Key="Fill2" Color="#2C2C2E"/>
        <SolidColorBrush x:Key="Fill3" Color="#3A3A3C"/>
        <SolidColorBrush x:Key="Orange" Color="#FF9F0A"/>
        <SolidColorBrush x:Key="Green" Color="#30D158"/>
        <SolidColorBrush x:Key="Red" Color="#FF453A"/>

        <!-- Shared button motion: the highlight fades in on hover, presses squish and spring back (targets "g" / "hl" in each template) -->
        <Storyboard x:Key="HoverIn"><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0.13" Duration="0:0:0.14"/></Storyboard>
        <Storyboard x:Key="HoverOut"><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"/></Storyboard>
        <Storyboard x:Key="PressIn">
            <DoubleAnimation Storyboard.TargetName="g" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.86" Duration="0:0:0.09"/>
            <DoubleAnimation Storyboard.TargetName="g" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.86" Duration="0:0:0.09"/>
        </Storyboard>
        <Storyboard x:Key="PressOut">
            <DoubleAnimation Storyboard.TargetName="g" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.42">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.55"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="g" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.42">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.55"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Round, borderless glyph button (SF Symbols feel) -->
        <Style x:Key="Glyph" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="g" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <Border x:Name="hl" CornerRadius="999" Background="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled circle button (Apple Timer / Stopwatch controls) -->
        <Style x:Key="Circle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A3A3C"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="g" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <Ellipse Fill="{TemplateBinding Background}"/>
                            <Ellipse x:Name="hl" Fill="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Capsule text button -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="g" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <Border CornerRadius="999" Background="{TemplateBinding Background}"/>
                            <Border x:Name="hl" CornerRadius="999" Background="White" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS segmented control segment: sits in a rounded track, the checked one is a raised grey tile -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="7" Background="Transparent">
                            <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#636366"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                                <Setter TargetName="cp" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#0A84FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="10" Background="#1C1C1E" BorderBrush="#33FFFFFF" BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderThickness" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hairline scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#55FFFFFF"/></ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS-style tooltip -->
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="SF Pro Text, ./Assets/Fonts/#Inter, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#F2262628" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="7" Padding="9,5">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS-style dark context menu -->
        <Style x:Key="AppleMenu" TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="FontFamily" Value="SF Pro Text, ./Assets/Fonts/#Inter, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F2262628" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="10" Padding="5" MinWidth="190">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppleMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="b" CornerRadius="5" Padding="10,4" Background="Transparent">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#0A84FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppleSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator"><Rectangle Height="1" Fill="#26FFFFFF" Margin="8,4"/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="T1" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
        <Style x:Key="T2" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Secondary}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
        <Style x:Key="Tiny" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource Secondary}"/></Style>
    </Window.Resources>

    <Canvas x:Name="Root">
        <!-- island silhouette (drawn in canvas coordinates so notch "ears" can extend outside the content box) -->
        <Path x:Name="Shape" Fill="Black"/>
        <!-- ambient glow: a 16px copy of the artwork stretched smoothly reads as a heavy blur, without a blur effect's cost.
             It shares the silhouette's geometry so it fills the square screen-side corners and notch ears too. -->
        <Path x:Name="AmbientShape" Opacity="0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>

        <Grid x:Name="Island" AllowDrop="True" Background="Transparent">
            <!-- ================= COMPACT ================= -->
            <Grid x:Name="CompactView" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform x:Name="CompactScale"/></Grid.RenderTransform>
                <Grid x:Name="CompactGrid" Margin="12,0">
                    <!-- leans towards the approaching pointer (iPadOS pointer magnetism) -->
                    <Grid.RenderTransform><TranslateTransform x:Name="CompactShift"/></Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="CLead" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border x:Name="CArt" Width="22" Height="22" CornerRadius="6" Visibility="Collapsed"/>
                        <TextBlock x:Name="CLeadIcon" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <c:BatteryGlyph x:Name="CBatt" Visibility="Collapsed" VerticalAlignment="Center"/>
                        <c:AnalogClock x:Name="CAnalog" Width="22" Height="22" Visibility="Collapsed"/>
                        <!-- Apple Watch Activity-style rings: CPU outside, RAM inside -->
                        <Grid x:Name="CRings" Width="24" Height="24" Visibility="Collapsed">
                            <c:Ring x:Name="CRingCpu" Thickness="3.5" Color="#FA114F"/>
                            <c:Ring x:Name="CRingRam" Margin="5" Thickness="3.5" Color="#92E82A"/>
                        </Grid>
                        <!-- iOS Calendar-style date: red weekday over the day number -->
                        <StackPanel x:Name="CCal" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="CCalDay" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource Red}" HorizontalAlignment="Center" LineHeight="9" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock x:Name="CCalNum" FontSize="16" FontWeight="SemiBold" FontFamily="SF Pro Display, ./Assets/Fonts/#Inter Display, ./Assets/Fonts/#Inter" HorizontalAlignment="Center" LineHeight="17" LineStackingStrategy="BlockLineHeight"/>
                        </StackPanel>
                        <!-- pinned match, Apple Sports Live Activity: each side of the island carries one team, mirrored -->
                        <TextBlock x:Name="CScoreA" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>

                    <Grid x:Name="CCenter" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
                        <TextBlock x:Name="CText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" Visibility="Collapsed"/>
                        <c:DotMatrixText x:Name="CDots" Dot="2.3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel x:Name="CBold" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="CBoldTop" FontSize="24" FontWeight="Bold" FontFamily="SF Pro Display, ./Assets/Fonts/#Inter Display, ./Assets/Fonts/#Inter" HorizontalAlignment="Center" LineHeight="23" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock x:Name="CBoldBottom" FontSize="24" FontWeight="Bold" FontFamily="SF Pro Display, ./Assets/Fonts/#Inter Display, ./Assets/Fonts/#Inter" HorizontalAlignment="Center" LineHeight="23" LineStackingStrategy="BlockLineHeight"/>
                        </StackPanel>
                        <c:EyesControl x:Name="CEyes" Width="64" Height="20" Visibility="Collapsed"/>
                        <Ellipse x:Name="CDot" Width="8" Height="8" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="CDotScale"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <c:Orb x:Name="COrb" Width="96" Height="22" Visibility="Collapsed"/>
                        <Border x:Name="CGap" Width="96" Height="1" Visibility="Collapsed"/>
                        <TextBlock x:Name="CScoreStatus" FontSize="11.5" FontWeight="SemiBold" MinWidth="64" MaxWidth="130" Margin="6,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>

                    <Grid x:Name="CTrail" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <c:Waveform x:Name="CWave" Width="26" Height="16" Visibility="Collapsed"/>
                        <TextBlock x:Name="CTrailText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <c:Ring x:Name="CRing" Width="18" Height="18" Thickness="2.5" Visibility="Collapsed"/>
                        <TextBlock x:Name="CScoreB" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>

                    <Ellipse x:Name="CPrivacy" Grid.Column="3" Width="6" Height="6" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
                <Rectangle x:Name="CProgress" Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,0,3" RadiusX="1" RadiusY="1" Fill="{StaticResource Orange}" Visibility="Collapsed"/>
            </Grid>

            <!-- ================= EXPANDED ================= -->
            <Grid x:Name="ExpandedView" Visibility="Collapsed" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform><ScaleTransform x:Name="ExpandedScale"/></Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- header: only exists for the "Header" tab style; the island itself carries no chrome, like iOS -->
                <Grid x:Name="Header" Grid.Row="0" Margin="16,10,12,0" Visibility="Collapsed">
                    <StackPanel x:Name="TabIcons" Orientation="Horizontal" HorizontalAlignment="Left"/>
                </Grid>

                <Grid x:Name="Pages" Grid.Row="1" Margin="18,2,18,6">
                    <Grid.RenderTransform><TranslateTransform x:Name="PagesShift"/></Grid.RenderTransform>

                    <!-- ===== HOME (start page when nothing is playing) ===== -->
                    <Grid x:Name="PageHome" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Home Clock Style (ApplyHomeStyle): Digital, Bold, Analog, Dot Matrix or Calendar -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <c:AnalogClock x:Name="HomeAnalog" Width="58" Height="58" Margin="0,0,14,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <Border x:Name="HomeCal" Width="58" Height="58" CornerRadius="13" Background="#1C1C1E" Margin="0,0,14,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="HomeCalDay" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Red}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="HomeCalNum" FontSize="28" FontFamily="SF Pro Display, ./Assets/Fonts/#Inter Display, ./Assets/Fonts/#Inter" HorizontalAlignment="Center" Margin="0,-5,0,-3"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="HomeTime" FontSize="46" FontWeight="Light" FontFamily="SF Pro Display, ./Assets/Fonts/#Inter Display, ./Assets/Fonts/#Inter" Margin="0,-8,0,-4"><Run x:Name="HomeHour"/><Run x:Name="HomeMin"/></TextBlock>
                                    <c:DotMatrixText x:Name="HomeDots" Dot="4" HorizontalAlignment="Left" Margin="1,2,0,7" Visibility="Collapsed"/>
                                    <TextBlock x:Name="HomeDate" Style="{StaticResource T2}" FontSize="13.5"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- two chips per column; a third starts a new one rather than growing the page -->
                            <WrapPanel x:Name="HomeChips" Grid.Column="1" Orientation="Vertical" MaxHeight="70" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- last session, one click from playing again -->
                        <Border x:Name="HomeResume" Grid.Row="1" Margin="0,12,0,0" CornerRadius="14" Background="#1C1C1E" Padding="8" Cursor="Hand" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="HomeArt" Width="36" Height="36" CornerRadius="9" Background="#2C2C2E"/>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HomeTrack" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="HomeArtist" Style="{StaticResource Tiny}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button x:Name="HomePlay" Grid.Column="2" Style="{StaticResource Glyph}" Width="36" Height="36"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===== MEDIA ===== -->
                    <Grid x:Name="PageMedia">
                        <Grid x:Name="MediaMain">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="MHeader" Grid.Row="0">
                                <Grid.RenderTransform><TranslateTransform x:Name="MHeaderShift"/></Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- album art with the source app's icon tucked into its corner (macOS Now Playing style) -->
                                <Grid Width="58" Height="58" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><ScaleTransform x:Name="MArtScale"/></Grid.RenderTransform>
                                    <Border x:Name="MArt" CornerRadius="14" Background="#2C2C2E" Cursor="Hand" ToolTip="Show player">
                                        <TextBlock x:Name="MArtPlaceholder" Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="MBadge" Width="22" Height="22" CornerRadius="7" BorderBrush="Black" BorderThickness="2" Background="#3A3A3C"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-7,-7" Cursor="Hand" Visibility="Collapsed">
                                        <TextBlock x:Name="MBadgeGlyph" Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="16,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="MTitle" Style="{StaticResource T1}" Text="Not Playing"/>
                                    <TextBlock x:Name="MArtist" Style="{StaticResource T2}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <c:Waveform x:Name="MWave" Grid.Column="2" Width="30" Height="22" VerticalAlignment="Top" Margin="0,8,2,0"/>
                            </Grid>

                            <StackPanel x:Name="MLyrics" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="MLyric0" FontSize="12" Foreground="{StaticResource Tertiary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MLyric1" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                                <TextBlock x:Name="MLyric2" FontSize="12" Foreground="{StaticResource Tertiary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MElapsed" Style="{StaticResource Tiny}" Text="0:00" VerticalAlignment="Center"/>
                                <c:SeekBar x:Name="MSeek" Grid.Column="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MRemain" Grid.Column="2" Style="{StaticResource Tiny}" Text="-0:00" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,4,0,0" Height="44">
                                <StackPanel x:Name="MQuickApps" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <StackPanel x:Name="MControls" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="PrevBtn" Style="{StaticResource Glyph}" Width="46" Height="44" Margin="0,0,8,0">
                                        <Path Data="{StaticResource GPrev}" Fill="White" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" Width="23" Height="15" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="PlayBtn" Style="{StaticResource Glyph}" Width="48" Height="48" RenderTransformOrigin="0.5,0.5">
                                        <Button.RenderTransform><ScaleTransform x:Name="PlayScale"/></Button.RenderTransform>
                                    </Button>
                                    <Button x:Name="NextBtn" Style="{StaticResource Glyph}" Width="46" Height="44" Margin="8,0,0,0">
                                        <Path Data="{StaticResource GNext}" Fill="White" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" Width="23" Height="15" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                                <Grid x:Name="MVolumeRow" Visibility="Collapsed" Background="Transparent" Margin="0,0,36,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="MuteBtn" Style="{StaticResource Glyph}" Content="&#xE767;"/>
                                    <c:SeekBar x:Name="VolSeek" Grid.Column="1" VerticalAlignment="Center" Margin="6,0"/>
                                    <TextBlock x:Name="VolText" Grid.Column="2" Style="{StaticResource Tiny}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="LyricsBtn" Style="{StaticResource Glyph}" Content="&#xE8BD;" FontSize="14" Width="30" Height="30" ToolTip="Floating lyrics" Foreground="{StaticResource Secondary}"/>
                                    <Button x:Name="RadarBtn" Style="{StaticResource Glyph}" Content="&#xE93E;" FontSize="15" Width="30" Height="30" ToolTip="Music Radar — identify the song playing" Foreground="{StaticResource Secondary}"/>
                                    <Button x:Name="VolumeBtn" Style="{StaticResource Glyph}" Content="&#xE767;" FontSize="15" Width="30" Height="30" ToolTip="Volume (scroll to adjust)" Foreground="{StaticResource Secondary}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Music Radar overlay -->
                        <Grid x:Name="RadarView" Background="Transparent" Visibility="Collapsed">
                            <Grid x:Name="RadarListening">
                                <Grid Width="70" Height="70" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Ellipse x:Name="RadarPulse1" Stroke="#0A84FF" StrokeThickness="2"/>
                                    <Ellipse x:Name="RadarPulse2" Stroke="#0A84FF" StrokeThickness="2"/>
                                    <Ellipse Width="44" Height="44" Fill="#0A84FF"/>
                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center" Margin="100,0,40,0">
                                    <TextBlock Text="Music Radar" Style="{StaticResource T1}"/>
                                    <TextBlock x:Name="RadarStatus" Style="{StaticResource T2}" Text="Listening…"/>
                                </StackPanel>
                                <Button x:Name="RadarCancel" Style="{StaticResource Glyph}" Content="&#xE711;" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            </Grid>
                            <Grid x:Name="RadarResult" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="RadarCover" Width="86" Height="86" CornerRadius="16" Background="#2C2C2E" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SHAZAMED" FontSize="10" FontWeight="Bold" Foreground="#0A84FF"/>
                                    <TextBlock x:Name="RadarTitle" Style="{StaticResource T1}" FontSize="17" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="RadarArtist" Style="{StaticResource T2}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="RadarSpotify" Style="{StaticResource Pill}" Background="#1DB954" Content="Spotify" Margin="0,0,6,0"/>
                                        <Button x:Name="RadarYouTube" Style="{StaticResource Pill}" Background="#FF0033" Content="YouTube" Margin="0,0,6,0"/>
                                        <Button x:Name="RadarCopy" Style="{StaticResource Pill}" Content="Copy" Margin="0,0,6,0"/>
                                        <Button x:Name="RadarClose" Style="{StaticResource Pill}" Content="Done"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ===== TIMER ===== -->
                    <Grid x:Name="PageTimer" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border CornerRadius="9" Background="#1C1C1E" Padding="2">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="SegTimer" Style="{StaticResource Segment}" GroupName="seg" Content="Timer" IsChecked="True"/>
                                <RadioButton x:Name="SegStopwatch" Style="{StaticResource Segment}" GroupName="seg" Content="Stopwatch"/>
                                <RadioButton x:Name="SegFocus" Style="{StaticResource Segment}" GroupName="seg" Content="Focus"/>
                            </UniformGrid>
                        </Border>

                        <!-- timer: setup -->
                        <Grid x:Name="TimerSetup" Grid.Row="1" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <WrapPanel x:Name="TimerPresets"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Custom" Style="{StaticResource T2}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="TimerMin" Style="{StaticResource Field}" Width="52" Text="10" TextAlignment="Center"/>
                                <TextBlock Text="min" Style="{StaticResource Tiny}" VerticalAlignment="Center" Margin="6,0,10,0"/>
                                <TextBox x:Name="TimerSec" Style="{StaticResource Field}" Width="52" Text="00" TextAlignment="Center"/>
                                <TextBlock Text="sec" Style="{StaticResource Tiny}" VerticalAlignment="Center" Margin="6,0,14,0"/>
                                <Button x:Name="TimerStartCustom" Style="{StaticResource Pill}" Background="#FF9F0A" Foreground="Black" Content="Start"/>
                            </StackPanel>
                        </Grid>

                        <!-- timer / focus: running (Apple Timer Live Activity) -->
                        <Grid x:Name="TimerRunning" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="TimerPause" Style="{StaticResource Circle}" Background="#4D3A1F00" Foreground="#FF9F0A" Content="&#xF8AE;"/>
                                <Button x:Name="TimerCancel" Style="{StaticResource Circle}" Content="&#xE711;" FontSize="14" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TimerLabel" Text="Timer" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Orange}" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="TimerBig" Text="0:00" FontSize="46" FontWeight="Light" FontFamily="SF Pro Display, ./Assets/Fonts/#Inter Display, ./Assets/Fonts/#Inter" Foreground="{StaticResource Orange}" HorizontalAlignment="Right" Margin="0,-6,0,-6"/>
                            </StackPanel>
                            <Grid Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="3" Margin="0,0,0,-2">
                                <Rectangle Fill="#33FF9F0A" RadiusX="1.5" RadiusY="1.5"/>
                                <Rectangle x:Name="TimerBar" Fill="#FF9F0A" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </Grid>

                        <!-- stopwatch -->
                        <Grid x:Name="StopwatchView" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="SwLap" Style="{StaticResource Circle}" FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" FontWeight="SemiBold" Content="Reset"/>
                                <Button x:Name="SwStart" Style="{StaticResource Circle}" Background="#1A3A20" Foreground="#30D158" FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" FontWeight="SemiBold" Content="Start" Margin="10,0,0,0"/>
                            </StackPanel>
                            <ScrollViewer x:Name="LapsScroll" Grid.Column="1" Margin="12,0" MaxHeight="74" VerticalScrollBarVisibility="Auto" VerticalAlignment="Center">
                                <StackPanel x:Name="SwLaps"/>
                            </ScrollViewer>
                            <TextBlock x:Name="SwBig" Grid.Column="2" Text="0:00.00" FontSize="40" FontWeight="Light" FontFamily="SF Pro Display, ./Assets/Fonts/#Inter Display, ./Assets/Fonts/#Inter" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- ===== CLIPBOARD ===== -->
                    <Grid x:Name="PageClipboard" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBox x:Name="ClipSearch" Style="{StaticResource Field}" Padding="30,10,8,10"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="ClipSearchHint" Text="Search clips" Foreground="{StaticResource Tertiary}" VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,8,0,6">
                            <Border CornerRadius="9" Background="#1C1C1E" Padding="2" Margin="0,0,34,0">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="FAll" Style="{StaticResource Segment}" GroupName="cf" Content="All" IsChecked="True"/>
                                    <RadioButton x:Name="FImages" Style="{StaticResource Segment}" GroupName="cf" Content="Images"/>
                                    <RadioButton x:Name="FUrls" Style="{StaticResource Segment}" GroupName="cf" Content="Links"/>
                                    <RadioButton x:Name="FText" Style="{StaticResource Segment}" GroupName="cf" Content="Text"/>
                                    <RadioButton x:Name="FPinned" Style="{StaticResource Segment}" GroupName="cf" Content="Pinned"/>
                                </UniformGrid>
                            </Border>
                            <Button x:Name="ClipClear" Style="{StaticResource Glyph}" Width="26" Height="26" FontSize="12" Content="&#xE74D;" HorizontalAlignment="Right" ToolTip="Clear unpinned clips" Foreground="{StaticResource Secondary}"/>
                        </Grid>
                        <ScrollViewer x:Name="ClipScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ClipList"/>
                        </ScrollViewer>
                        <TextBlock x:Name="ClipEmpty" Grid.Row="2" Text="Copy text, images, or drop files here" Style="{StaticResource T2}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Grid Grid.Row="3" Margin="0,4,0,0">
                            <TextBlock x:Name="ClipCount" Style="{StaticResource Tiny}" VerticalAlignment="Center"/>
                            <Button x:Name="ClipMore" Style="{StaticResource Pill}" Padding="10,3" HorizontalAlignment="Right" Content="Load More" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>

                    <!-- ===== QUICK LAUNCH ===== -->
                    <Grid x:Name="PageApps" Visibility="Collapsed">
                        <ScrollViewer x:Name="AppsScroll" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="AppsPanel" HorizontalAlignment="Center"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== NOTES (extra) ===== -->
                    <Grid x:Name="PageNotes" Visibility="Collapsed">
                        <TextBox x:Name="NotesBox" Style="{StaticResource Field}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="13.5"/>
                        <TextBlock x:Name="NotesHint" Text="Quick notes — saved automatically" Foreground="{StaticResource Tertiary}" Margin="10,10" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- ===== TASKS (extra) ===== -->
                    <Grid x:Name="PageTasks" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBox x:Name="TaskBox" Style="{StaticResource Field}" Padding="30,10,8,10"/>
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="TaskHint" Text="New task — press Enter" Foreground="{StaticResource Tertiary}" VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        <ScrollViewer x:Name="TaskScroll" Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="TaskList"/>
                        </ScrollViewer>
                        <TextBlock x:Name="TaskEmpty" Grid.Row="1" Text="No tasks — you're all caught up" Style="{StaticResource T2}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- ===== SCORES (extra): click a match to pin it as a live activity ===== -->
                    <Grid x:Name="PageScores" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border CornerRadius="9" Background="#1C1C1E" Padding="2">
                            <UniformGrid x:Name="ScoreChips" Rows="1"/>
                        </Border>
                        <ScrollViewer x:Name="ScoreScroll" Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ScoreList"/>
                        </ScrollViewer>
                        <TextBlock x:Name="ScoreEmpty" Grid.Row="1" Style="{StaticResource T2}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- ===== OCR RESULT ===== -->
                    <Grid x:Name="PageOcr" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Extracted Text" Style="{StaticResource T1}"/>
                        <TextBox x:Name="OcrText" Grid.Row="1" Margin="0,8" Style="{StaticResource Field}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="OcrCopy" Style="{StaticResource Pill}" Background="#0A84FF" Content="Copy" Margin="0,0,8,0"/>
                            <Button x:Name="OcrDismiss" Style="{StaticResource Pill}" Content="Dismiss"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== DROP ZONE ===== -->
                    <Grid x:Name="PageDrop" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="DropFolder" Margin="0,0,6,0" CornerRadius="18" BorderThickness="1.5" BorderBrush="#55FFFFFF" Background="#141416" AllowDrop="True">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="26" HorizontalAlignment="Center" Foreground="#0A84FF"/>
                                <TextBlock Text="Save to Folder" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBlock x:Name="DropFolderName" Style="{StaticResource Tiny}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="DropClips" Grid.Column="1" Margin="6,0,0,0" CornerRadius="18" BorderThickness="1.5" BorderBrush="#55FFFFFF" Background="#141416" AllowDrop="True">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE77F;" FontFamily="{StaticResource Icons}" FontSize="26" HorizontalAlignment="Center" Foreground="#30D158"/>
                                <TextBlock Text="Add to Clipboard Shelf" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBlock Text="Text, links, images &amp; files" Style="{StaticResource Tiny}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== WELCOME TOUR ===== -->
                    <Grid x:Name="PageTour" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Width="64" Height="64" CornerRadius="18" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="TourGrad1" Color="#0A84FF" Offset="0"/>
                                    <GradientStop x:Name="TourGrad2" Color="#5E5CE6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock x:Name="TourIcon" FontFamily="{StaticResource Icons}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TourStep" Style="{StaticResource Tiny}"/>
                            <TextBlock x:Name="TourTitle" FontSize="19" FontWeight="Bold" FontFamily="SF Pro Display, ./Assets/Fonts/#Inter Display, ./Assets/Fonts/#Inter" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TourDesc" Style="{StaticResource T2}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <Button x:Name="TourSkip" Style="{StaticResource Pill}" Background="Transparent" Foreground="{StaticResource Secondary}" Content="Skip" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="TourBack" Style="{StaticResource Pill}" Content="Back" Margin="0,0,8,0"/>
                                <Button x:Name="TourNext" Style="{StaticResource Pill}" Background="#0A84FF" Content="Next"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- page dots + pin button (the button moves into the header for the Header tab style) -->
                <StackPanel x:Name="DotsRow" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,7">
                    <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <Button x:Name="PinBtn" Style="{StaticResource Glyph}" Width="22" Height="18" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ================= POPUP (transient live activity) ================= -->
            <Grid x:Name="PopupView" Visibility="Collapsed" Margin="14,0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform x:Name="PopupScale"/></Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- entrance is staggered: artwork pops, text glides in, the trailing accessory pops last -->
                <Grid x:Name="PLead" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="PLeadScale"/></Grid.RenderTransform>
                    <Border x:Name="PArt" Width="44" Height="44" CornerRadius="11" Visibility="Collapsed"/>
                    <Grid x:Name="PIconWrap" Visibility="Collapsed">
                        <Ellipse x:Name="PIconBg" Width="40" Height="40" Fill="#2C2C2E"/>
                        <TextBlock x:Name="PIcon" FontFamily="{StaticResource Icons}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="PLeadText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
                <StackPanel x:Name="PTexts" Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="PTextsShift"/></StackPanel.RenderTransform>
                    <TextBlock x:Name="PTitle" Style="{StaticResource T1}" FontSize="14"/>
                    <TextBlock x:Name="PSub" Style="{StaticResource T2}" FontSize="12.5"/>
                </StackPanel>
                <Grid x:Name="PTrail" Grid.Column="2" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="PTrailScale"/></Grid.RenderTransform>
                    <Path x:Name="PGlyph" Width="16" Height="19" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" Visibility="Collapsed"/>
                    <StackPanel x:Name="PBattWrap" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="PBattText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <c:BatteryGlyph x:Name="PBatt" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid x:Name="PRingWrap" Width="36" Height="36" Visibility="Collapsed">
                        <c:Ring x:Name="PRing" Thickness="3.5"/>
                        <TextBlock x:Name="PRingText" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <c:Waveform x:Name="PWave" Width="30" Height="22" Visibility="Collapsed"/>
                    <TextBlock x:Name="PTrailText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Grid x:Name="PBarWrap" Width="110" Height="6" Visibility="Collapsed">
                        <Rectangle Fill="#33FFFFFF" RadiusX="3" RadiusY="3"/>
                        <Rectangle x:Name="PBar" Fill="White" RadiusX="3" RadiusY="3" HorizontalAlignment="Left"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Apple "minimal" bubble: second live activity shown beside the island -->
        <Grid x:Name="Bubble" Width="34" Height="34" Visibility="Collapsed" Cursor="Hand">
            <Ellipse x:Name="BubbleBg" Fill="Black"/>
            <c:Ring x:Name="BubbleRing" Margin="5" Thickness="2.5" Color="#FF9F0A"/>
            <TextBlock x:Name="BubbleIcon" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#FF9F0A" HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE916;"/>
        </Grid>

        <c:PetControl x:Name="Pet" Visibility="Collapsed"/>
    </Canvas>
</Window>
